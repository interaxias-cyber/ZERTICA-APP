# Dirección del backend Zertica (incluye /api al final).
# Si se deja vacío, en desarrollo la app usa automáticamente la IP del equipo
# que ejecuta "npx expo start" y el puerto EXPO_PUBLIC_API_PORT.
#
#   Emulador Android ............ http://10.0.2.2:3000/api
#   Teléfono físico (misma Wi-Fi) http://<IP-de-tu-PC>:3000/api   (ej. http://192.168.1.50:3000/api)
#   Navegador / entorno local ... http://localhost:3000/api
EXPO_PUBLIC_API_URL=

# Puerto del backend usado cuando EXPO_PUBLIC_API_URL está vacío.
EXPO_PUBLIC_API_PORT=3000

# Tiempo máximo de espera por petición, en milisegundos (conexiones lentas).
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=20000
