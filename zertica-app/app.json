{
  "expo": {
    "name": "Zertica",
    "slug": "zertica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zertica",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.zertica.drywallshop",
      "supportsTablet": false
    },
    "android": {
      "package": "com.zertica.drywallshop",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#081B39",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081B39",
          "image": "./assets/images/logo-wordmark.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zertica necesita acceder a tus fotos para cargar la imagen del producto.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
