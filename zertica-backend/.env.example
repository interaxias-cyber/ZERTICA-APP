# ---- Servidor ----
NODE_ENV=development
PORT=3000
# 0.0.0.0 permite conexiones desde el emulador y desde un teléfono en la misma red Wi-Fi
HOST=0.0.0.0
CORS_ORIGIN=*
# URL pública con la que la app descarga las imágenes. Vacío = se usa el host de cada petición.
# Ejemplo dispositivo físico: http://192.168.1.50:3000
PUBLIC_BASE_URL=

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zertica
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=zertica
# Opcional: socket local de MySQL/MariaDB (p. ej. en Termux). Si se define, se usa en lugar de host/puerto.
DB_SOCKET=
# Usuario con permiso para CREATE DATABASE (solo para npm run db:init). Vacío = DB_USER
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ---- Autenticación ----
# Cadena larga y aleatoria. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h
RESET_TOKEN_EXPIRES_IN=30m
BCRYPT_ROUNDS=10

# ---- Imágenes de producto ----
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=5

# ---- Correo (recuperación de contraseña). Opcional. ----
# Sin SMTP_HOST, en desarrollo el código de recuperación se muestra en la consola
# del servidor y se devuelve en la respuesta (devResetToken). En producción no.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Zertica <no-reply@zertica.local>
