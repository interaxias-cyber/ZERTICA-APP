{
  "name": "zertica-backend",
  "version": "1.0.0",
  "description": "API REST de Zertica – Drywall Shop (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "~4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16"
  }
}
